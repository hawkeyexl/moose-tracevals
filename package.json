{
  "name": "@hawkeyexl/agentevals",
  "version": "0.0.0-development",
  "description": "Deterministic and LLM-as-judge adherence evals for AI agent session traces. Did the session follow the skills and instructions it used?",
  "type": "module",
  "bin": {
    "agentevals": "dist/cli.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/artifact-evals-0.2.json": "./schemas/artifact-evals-0.2.json",
    "./schemas/artifact-evals-0.1.json": "./schemas/artifact-evals-0.1.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hawkeyexl/agentevals.git"
  },
  "bugs": {
    "url": "https://github.com/hawkeyexl/agentevals/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "agents",
    "evals",
    "llm-as-judge",
    "claude-code",
    "traces",
    "skills",
    "testing",
    "cli",
    "ci"
  ],
  "license": "MIT",
  "dependencies": {
    "@hawkeyexl/inference": "^0.0.1",
    "@inquirer/prompts": "^7.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "docmeta": "^1.3.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.0.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.8",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
