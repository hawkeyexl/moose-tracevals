{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moose-tracevals:config:0.1",
  "title": "tracevals section of moose.config.yaml",
  "description": "Settings for moose-tracevals, held under the `tracevals` key of the config file shared by the moose family of tools. Sibling keys belong to other tools and are not validated here.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "description": "Inference provider settings. Configure any number of sections and select one with `default` or --provider; only the selected section is mapped onto the inference library's ProviderSpec.",
      "properties": {
        "default": {
          "enum": ["anthropic", "openai", "claude-cli", "mock"],
          "description": "Which provider to use when --provider is not passed."
        },
        "anthropic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "apiKeyEnv": {
              "type": "string",
              "minLength": 1,
              "description": "Name of the environment variable holding the API key — never the key itself."
            },
            "pricing": { "$ref": "#/$defs/pricing" }
          }
        },
        "openai": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseUrl": {
              "type": "string",
              "minLength": 1,
              "description": "Any /chat/completions-compatible server (OpenAI, Azure, Ollama, Groq, Together)."
            },
            "model": { "type": "string", "minLength": 1 },
            "apiKeyEnv": { "type": "string", "minLength": 1 },
            "pricing": { "$ref": "#/$defs/pricing" }
          }
        },
        "claude-cli": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "command": {
              "type": "string",
              "minLength": 1,
              "description": "Executable to run. Uses the Claude CLI's own local auth, so no API key is needed."
            }
          }
        }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ensembleRuns": { "type": "integer", "minimum": 1 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "zones": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "autoPass": { "type": "number", "minimum": 0, "maximum": 1 },
            "autoFail": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "cacheDir": { "type": "string" },
        "maxCostUsd": { "type": "number", "minimum": 0 }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBlockChars": { "type": "integer", "minimum": 100 },
        "maxTotalChars": { "type": "integer", "minimum": 1000 }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" }
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confidenceThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxEvalsPerArtifact": { "type": "integer", "minimum": 1 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "cacheDir": { "type": "string" },
        "maxCostUsd": { "type": "number", "minimum": 0 }
      }
    },
    "failOnNeedsReview": { "type": "boolean" },
    "plugins": {
      "type": "array",
      "description": "Modules imported before evals are planned, so one calling registerGrader() can add a grader kind the built-ins do not cover. A relative or absolute path resolves against this file's directory, not the working directory; a bare package name resolves the way an import from this file's directory would. Load order is significant: a later entry wins a colliding kind.",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputPerMTok", "outputPerMTok"],
      "description": "USD per million tokens. Overrides the inference library's built-in table for this model.",
      "properties": {
        "inputPerMTok": { "type": "number", "minimum": 0 },
        "outputPerMTok": { "type": "number", "minimum": 0 }
      }
    }
  }
}
